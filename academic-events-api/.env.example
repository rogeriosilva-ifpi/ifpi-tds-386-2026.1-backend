# ============================================================
# Arquivo de Exemplo de Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# NUNCA versione o arquivo .env com dados reais!
# ============================================================

# --- Configuração da Aplicação ---
APP_ENV=development       # Ambiente: development | production | testing
APP_NAME="Academic Events API"
DEBUG=true

# --- Banco de Dados ---
# SQLite (padrão, não precisa instalar nada):
DATABASE_URL=sqlite:///./academic_events.db

# PostgreSQL (descomente para usar):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/academic_events

# MySQL (descomente para usar):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/academic_events
